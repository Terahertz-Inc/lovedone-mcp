{
  "name": "lovedone-family",
  "displayName": "LovedOne Family Inbox",
  "description": "Senior tech support for families: one LovedOne household's Family Inbox, loved ones and members, so caregivers can coordinate help. May include personal messages; handle with care.",
  "version": "0.4.1",
  "author": {
    "name": "Terahertz, Inc.",
    "email": "support@lovedone.app"
  },
  "homepage": "https://inbox.lovedone.app/agents",
  "repository": "https://github.com/Terahertz-Inc/lovedone-mcp",
  "license": "MIT",
  "keywords": [
    "mcp",
    "senior-tech-support",
    "family-inbox",
    "caregiver-coordination",
    "lovedone"
  ],
  "variables": {
    "type": "object",
    "properties": {
      "LOVEDONE_API_KEY": {
        "type": "string",
        "title": "LovedOne Family MCP key",
        "description": "API key minted at https://inbox.lovedone.app/settings/mcp-keys."
      }
    },
    "required": [
      "LOVEDONE_API_KEY"
    ]
  },
  "logo": "assets/logo.png"
}
