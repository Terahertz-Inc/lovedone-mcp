{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "app.lovedone/family-inbox",
  "description": "Authenticated MCP for one family household: loved ones, members, and Family Inbox plaintext.",
  "title": "LovedOne Family MCP",
  "repository": {
    "url": "https://github.com/Terahertz-Inc/lovedone-mcp",
    "source": "github"
  },
  "version": "0.4.0",
  "websiteUrl": "https://inbox.lovedone.app/agents",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.lovedone.app/mcp/v1",
      "headers": [
        {
          "description": "Bearer API key minted at https://inbox.lovedone.app/settings/mcp-keys",
          "isRequired": true,
          "isSecret": true,
          "name": "Authorization"
        }
      ]
    }
  ]
}
